# Copy to .env and fill in. Never commit the real file.
NODE_ENV=development
PORT=3001

# PostgreSQL (needs the pgvector extension)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledgeflow_ai
DB_USER=postgres
DB_PASSWORD=replace-me

# Auth
JWT_SECRET=replace-with-a-long-random-string

# AWS (credentials come from your AWS CLI profile / IAM role, not from this file)
AWS_REGION=eu-central-1
S3_BUCKET=your-documents-bucket
S3_REGION=eu-central-1

# Amazon Bedrock (optional overrides; defaults shown)
# BEDROCK_REGION=eu-central-1
# BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Email (Amazon SES). With EMAIL_ENABLED=false, invite/reset links are logged instead of sent.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@example.com
SES_REGION=eu-central-1
FRONTEND_URL=http://localhost:5173

# Deployment only (serverless.yml): the VPC the Lambda joins to reach RDS privately
# LAMBDA_SECURITY_GROUP_ID=sg-xxxxxxxx
# LAMBDA_SUBNET_ID_1=subnet-xxxxxxxx
# LAMBDA_SUBNET_ID_2=subnet-xxxxxxxx
# LAMBDA_SUBNET_ID_3=subnet-xxxxxxxx
